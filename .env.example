# Copy to .env and fill in local-only values. Never commit .env or real credentials.
APP_ENV=development
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-me
LOG_LEVEL=INFO

# Used by Docker Compose to create the local database.
POSTGRES_USER=campnet
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=campnet

# For running the backend outside Docker (Compose overrides these for containers).
DATABASE_URL=postgresql+psycopg://campnet:replace-me@localhost:5432/campnet
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=./var/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

OCR_DEFAULT_ADAPTER=tesseract
MAX_UPLOAD_BYTES=52428800
ALLOWED_ORIGINS=["http://localhost:5173"]
